{
  "title": {
    "max_length": 200,
    "template": "{brand} {purity} {metal_type} {stone_phrase} {product_type} {collection_phrase}for {audience} | Fine Jewellery",
    "audience_default": "Women",
    "stone_phrase_template": "{stone_creation_method} {stone_type}",
    "collection_prefix": "",
    "strip_phrases": ["Pure Gold", "Lab Grown Diamond", "Lab-Grown Diamond", "Lab Diamond"],
    "banned_words": ["free", "cheap", "best seller", "hot item", "guarantee", "sale", "discount"]
  },
  "bullets": {
    "count": 5,
    "max_length": 500,
    "templates": [
      "PURITY & METAL: Crafted in certified {purity} {metal_type} with a BIS Hallmark, ensuring authentic precious metal quality in every piece.",
      "LAB GROWN DIAMOND: Features {stone_detail} - ethically created, conflict-free and visually identical to mined diamonds at exceptional value.",
      "EXPERT CRAFTSMANSHIP: Each {product_type_lower} is handcrafted by Lukson artisans with precision setting and a premium mirror-polish finish.",
      "PERFECT FOR EVERY OCCASION: Elegant {product_type_lower} designed for weddings, engagements, anniversaries, festivals and everyday luxury.",
      "IDEAL GIFT: Arrives in premium Lukson packaging with an authenticity certificate - a memorable gift for birthdays, anniversaries and special moments."
    ]
  },
  "description": {
    "max_length": 2000,
    "strip_html": true,
    "template": "{title}. {body} Crafted in {purity} {metal_type} with {stone_phrase}, this piece reflects Lukson's commitment to fine jewellery excellence. Every Lukson creation is made in India with certified materials and delivered with an authenticity certificate in premium packaging.",
    "fallback_body": "Discover timeless design and modern elegance with this handcrafted piece from the Lukson fine jewellery collection."
  },
  "search_terms": {
    "max_bytes": 200,
    "separator": " ",
    "base_keywords": [
      "lab grown diamond",
      "gold jewellery",
      "fine jewellery",
      "certified diamond",
      "hallmark gold",
      "gift for her",
      "wedding jewellery",
      "engagement"
    ],
    "exclude_words": ["lukson", "amazon", "best", "cheap", "free"]
  },
  "validation": {
    "required_fields": [
      "item_sku",
      "item_name",
      "brand_name",
      "feed_product_type",
      "update_delete"
    ],
    "required_child_fields": ["standard_price", "quantity", "main_image_url"],
    "image_url_pattern": "^https?://[^\\s]+\\.(?:jpg|jpeg|png|gif|webp)(?:\\?[^\\s]*)?$",
    "sku_pattern": "^[A-Za-z0-9._\\-]{1,40}$",
    "price_min": 1,
    "price_max": 10000000
  },
  "variation": {
    "themes": {
      "gold color": "COLOR",
      "gold colour": "COLOR",
      "color": "COLOR",
      "colour": "COLOR",
      "finish": "COLOR",
      "ring size": "RING_SIZE",
      "size": "SIZE",
      "metal purity": "METAL_TYPE",
      "purity": "METAL_TYPE",
      "metal": "METAL_TYPE"
    },
    "combined_themes": {
      "COLOR|RING_SIZE": "COLOR/RING_SIZE",
      "COLOR|SIZE": "COLOR/SIZE",
      "METAL_TYPE|RING_SIZE": "METAL_TYPE/RING_SIZE",
      "COLOR|METAL_TYPE": "COLOR/METAL_TYPE",
      "COLOR|METAL_TYPE|RING_SIZE": "COLOR/METAL_TYPE/RING_SIZE"
    },
    "option_attributes": {
      "gold color": "_color",
      "gold colour": "_color",
      "color": "_color",
      "colour": "_color",
      "finish": "_color",
      "ring size": "_ring_size",
      "size": "_ring_size",
      "metal purity": "_metal_stamp",
      "purity": "_metal_stamp",
      "karat": "_metal_stamp",
      "metal": "_metal_stamp"
    },
    "relationship_type": "Variation",
    "parent_sku_prefix": "P-",
    "sku_duplicate_strategy": "suffix",
    "parent_fields_blanked": [
      "standard_price",
      "maximum_retail_price",
      "quantity",
      "external_product_id",
      "external_product_id_type",
      "fulfillment_latency",
      "ring_size",
      "size_name",
      "color_name",
      "metal_stamp",
      "metal_type"
    ]
  },
  "ring_size_fallback": "Adjustable",
  "stone": {
    "carat_range_columns": ["Carat Range (product.metafields.custom.carat_range)"],
    "carat_value_map": {
      "0-1-ct": "0.5",
      "1-1-5-ct": "1",
      "1-5-2-ct": "1.5",
      "2-0-ct": "2"
    },
    "default_carat": "0.5",
    "weight_unit": "Carats",
    "total_weight_unit": "carats",
    "default_color": "E-F"
  },
  "weight": {
    "metafield_columns": ["Gram Weight (product.metafields.custom.gram_weight)"],
    "value_map": {
      "0-2-g": "1",
      "2-5-g": "3.5",
      "5-10-g": "7.5",
      "10-20-g": "15"
    }
  },
  "occasion": {
    "columns": ["Occasion (product.metafields.custom.occasion)"],
    "value_map": {
      "engagement": "Engagement",
      "anniversary": "Anniversary",
      "birthday": "Birthday",
      "wedding": "Wedding",
      "diwali": "Diwali",
      "christmas": "Christmas",
      "valentine": "Valentine's Day",
      "valentines-day": "Valentine's Day"
    }
  },
  "purity_values": ["9K", "10K", "14K", "18K", "22K", "24K", "925 Sterling", "950 Platinum"],
  "metafield_columns": {
    "stone_type": ["Diamond Type (product.metafields.custom.diamond_type)", "Stone Type (product.metafields.custom.stone_type)"],
    "stone_shape": ["Diamond Shape (product.metafields.custom.diamond_shape)", "Stone shape (product.metafields.shopify.stone-shape)", "Stone Shape (product.metafields.custom.stone_shape)"],
    "stone_weight": ["Diamond Carat (product.metafields.custom.diamond_carat)", "Total Carat Weight (product.metafields.custom.total_carat_weight)"],
    "stone_clarity": ["Diamond Clarity (product.metafields.custom.diamond_clarity)"],
    "stone_color": ["Diamond Color (product.metafields.custom.diamond_color)"]
  }
}
